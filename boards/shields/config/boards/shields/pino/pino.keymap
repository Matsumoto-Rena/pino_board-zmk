#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>       // 追加: Bluetooth制御用
#include <dt-bindings/zmk/outputs.h>  // 追加: 出力切り替え用

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp A        &kp B         &kp C
                &bt BT_CLR   &out OUT_BLE  &out OUT_USB
            >;
        };
    };
};
